# Archivr runtime configuration. Copy to .env and adjust.

# Server
LISTEN_ADDR=:8080

# Public address the browser uses, for links and the SSO callback. Required behind a proxy.
# PUBLIC_URL=https://archive.example.org

# Data root. Holds archivr.db, the documents/ tree, the trash and the preview cache.
DATA_DIR=./data

# Folder polled for new files (scanner or sync drop). Defaults to DATA_DIR/ingest.
# WATCH_DIR=./data/ingest

# Set to any value when running behind a reverse proxy you control. Makes the client IP
# come from X-Forwarded-For and the HTTPS check come from X-Forwarded-Proto.
# TRUST_PROXY=1

# Session signing key. If empty, a random key is used for this run, so everyone is signed out on restart.
# JWT_SECRET=

# First admin account. Created on first start, and used as the sign-in email for INIT_PASSWORD.
# INIT_ADMIN_EMAIL=admin@archivr.local

# Bootstrap admin password, applied on every start while set. It resets that account's
# password and role, so remove it once you can sign in.
# INIT_PASSWORD=changeme

# Set to any value for verbose logging.
# DEBUG=1
